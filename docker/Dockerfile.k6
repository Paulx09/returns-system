FROM dunglas/frankenphp:php8.3-alpine

# Install PHP extensions needed by Laravel + PostgreSQL
RUN install-php-extensions \
    pdo_pgsql \
    pcntl \
    intl \
    zip \
    opcache

# Include Composer for dependency resilience in containerized test environments
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy application source code
COPY . /app

# Ensure writable permissions for runtime directories
RUN chmod -R 777 /app/storage /app/bootstrap/cache

# Server port configuration for FrankenPHP/Caddy
EXPOSE 8000

RUN printf "expose_php = Off\nupload_max_filesize = 10M\npost_max_size = 30M\n" > /usr/local/etc/php/conf.d/security.ini

COPY docker/Caddyfile /etc/frankenphp/Caddyfile
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
