{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:api": "newman run postman/returns-api.collection.json -e postman/local.environment.json --reporters cli",
        "test:api:report": "newman run postman/returns-api.collection.json -e postman/local.environment.json --reporters cli,htmlextra --reporter-htmlextra-export storage/app/qa-reports/api-report.html",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@playwright/test": "^1.64.0",
        "@react-aria/focus": "^3.22.1",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@vitejs/plugin-react": "^4.2.0",
        "@vitest/coverage-v8": "^5.0.1",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "newman": "^6.2.3",
        "newman-reporter-htmlextra": "^1.23.1",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-aria": "^3.52.1",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.2.1",
        "vite": "^7.0.7",
        "vitest": "^5.0.1",
        "vitest-axe": "^0.1.0"
    }
}
